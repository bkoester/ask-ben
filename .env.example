# --- storage ---
DATABASE_URL=postgresql://askben:askben@localhost:5433/askben

# --- embeddings: Titan Text Embeddings v2 on Bedrock, same instance role as the LLM ---
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- LLM: Haiku 4.5 on Bedrock via the instance role (no API key on the box) ---
BEDROCK_REGION=us-east-2
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- behaviour ---
ENABLED=true                     # false => every /ask returns the offline sentence, no model calls
DAILY_SPEND_CAP_USD=1.00         # Ben, 2026-09-05. Bot goes offline for the day when reached.
SIMILARITY_THRESHOLD=0.35        # below this, decline with "nothing from Ben on that" (no model call)
TOP_K=4
RATE_LIMIT_PER_10MIN=12          # per hashed IP
MAX_QUESTION_CHARS=300

# --- abuse ---
TURNSTILE_SECRET=                # empty => Turnstile check skipped (local dev only)
IP_HASH_SALT=change-me           # rotate to un-link stored ip hashes

# --- site ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://benkoester.com,https://www.benkoester.com
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?benkoester\.pages\.dev$
CITATION_BASE=https://github.com/bkoester/ask-ben/blob/main/corpus
STATS_PASSWORD=                  # basic-auth password for GET /stats (empty => endpoint disabled)
